<div class="shell pad article-grid">
  <aside :if={@sections != []} class="toc-col">
    <nav class="toc">
      <span class="micro" style="padding:0 10px 8px">Neste artigo</span>
      <a
        :for={{sec, i} <- Enum.with_index(@sections)}
        href={"##{sec["id"]}"}
        class={i == 0 && "is-active"}
        data-toc={sec["id"]}
      >
        <span class="n mono">{sec["n"]}</span>
        <span>{sec["title"]}</span>
      </a>

      <div style="margin-top:20px;padding:0 10px">
        <span class="micro">Progresso</span>
        <p class="small mono" style="margin-top:6px">
          <span id="read-pct">0%</span>
          · <span id="read-left">{@post.reading_minutes}</span>
          min restantes
        </p>
      </div>
    </nav>
  </aside>

  <article class="stack" style="gap:26px">
    <header class="stack" style="gap:16px">
      <span :if={@post.kind != "pagina"} class="kicker">
        {@post.kind}
        <span :for={topic <- @post.topics}>
          · <a href={~p"/tag/#{Blogo.Content.topic_slug(topic)}"} class="kicker-link">{topic}</a>
        </span>
      </span>
      <h1 class="h1">{@post.title}</h1>
      <p :if={@post.subtitle} class="dek">{BlogoWeb.Blocks.inline(@post.subtitle)}</p>

      <div
        :if={@post.kind != "pagina"}
        style="display:flex;align-items:center;gap:12px;flex-wrap:wrap"
      >
        <span class="byline">
          <span class="ava">{initials(@post.author.name)}</span>
          <span class="nm">{@post.author.name}</span>
          <span class="sep">·</span>
          <span>{format_date_long(@post.published_at)}</span>
          <span class="sep">·</span>
          <span>{@post.reading_minutes} min de leitura</span>
        </span>
        <span style="display:flex;gap:7px;margin-left:auto">
          <span :for={t <- @post.topics} class="tag">{t}</span>
        </span>
      </div>
    </header>

    <section
      :if={@summary}
      class="card"
      style="padding:26px 28px;display:flex;flex-direction:column;gap:18px"
    >
      <span class="kicker">Em resumo</span>
      <div class="stats">
        <div :for={item <- @summary["items"] || []} class="stat">
          <span class={["statn", item["accent"] && "is-accent"]}>{item["value"]}</span>
          <span class="small">{item["label"]}</span>
        </div>
      </div>
      <p
        :if={@summary["note"]}
        class="small"
        style="border-top:1px solid var(--line);padding-top:14px"
      >
        {@summary["note"]}
      </p>
    </section>

    <.render_blocks blocks={@blocks} />
  </article>
</div>

<%!-- The article tells the beacon which post it is and proves it is allowed to
      report on it. A preview has no token, so a draft being checked by its
      author never counts as a read. --%>
<div
  :if={assigns[:read_token]}
  id="read-beacon"
  hidden
  data-token={@read_token}
  data-endpoint={~p"/leitura"}
>
</div>

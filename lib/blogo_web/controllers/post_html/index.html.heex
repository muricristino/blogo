<div class="shell pad home">
  <article :if={@featured} class={["card feat", !@featured_hero && "feat--plain"]}>
    <div class="feat-text">
      <span class="kicker">{gettext("Featured")} · {kind_label(@featured.kind)}</span>
      <h1 class="h1 feat-title" lang={@featured.language}>{@featured.title}</h1>
      <p class="dek" lang={@featured.language}>{BlogoWeb.Blocks.inline(@featured.subtitle)}</p>
      <div class="feat-meta">
        <span :for={t <- @featured.topics} class="tag">{t}</span>
        <span class="small mono">{format_date(@featured.published_at)}</span>
        <span class="small mono">· {@featured.reading_minutes} min</span>
      </div>
      <a
        href={~p"/#{@featured.slug}"}
        class="feat-cta"
      >
        {gettext("Read the essay")}
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
    <div :if={@featured_hero} class="feat-fig">
      <.hero post={@featured} caption />
    </div>
  </article>

  <div class="home-grid">
    <div>
      <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:6px">
        <a class="chip is-on" href={~p"/"}>{gettext("All")} <span class="c">{@total}</span></a>
        <a :for={topic <- @topics} class="chip" href={~p"/tag/#{topic.slug}"}>
          {String.capitalize(topic.name)} <span class="c">{topic.count}</span>
        </a>
        <span class="small" style="margin-left:auto">{gettext("Sort by")}
        <b style="color:var(--ink2)">{gettext("most recent")}</b></span>
      </div>

      <%!-- The title and the summary are in the article's own language, whatever
            the menu around them says. --%>
      <a :for={post <- @posts} class="item" href={~p"/#{post.slug}"}>
        <div style="display:flex;flex-direction:column;gap:9px">
          <div class="byline">
            <span class="ava">{initials(post.author.name)}</span>
            <span class="nm">{post.author.name}</span>
            <span class="sep">·</span>
            <span>{format_date(post.published_at)}</span>
          </div>
          <h2 class="item-title" lang={post.language}>{post.title}</h2>
          <p class="item-dek" lang={post.language}>{BlogoWeb.Blocks.inline(post.subtitle)}</p>
          <div class="item-meta">
            <span class="mono">{post.reading_minutes} min</span>
            <span>·</span>
            <span :for={t <- post.topics} class="tag" style="font-size:11.5px;padding:3px 9px">{t}</span>
          </div>
        </div>
        <div class="thumb"><.hero post={post} /></div>
      </a>
    </div>

    <aside class="stack" style="gap:16px">
      <div class="card aside-card">
        <span class="micro">{gettext("Get it by e-mail")}</span>
        <p class="small">
          {gettext("One essay a week. No link roundups, no product newsletter.")}
        </p>
        <div class="field">
          <svg
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
          >
            <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
          </svg>
          {gettext("you@example.com")}
        </div>
        <button class="btn btn--p" type="button">{gettext("Subscribe")}</button>
      </div>

      <div :if={@author} class="card aside-card">
        <div style="display:flex;align-items:center;gap:11px">
          <span class="ava" style="width:38px;height:38px;font-size:13px">{initials(@author.name)}</span>
          <div>
            <div style="color:var(--ink);font-weight:600;font-size:15px">{@author.name}</div>
            <div class="small">{@author.city} · {gettext("since 2023")}</div>
          </div>
        </div>
        <p class="small">{@author.bio}</p>
        <div style="display:flex;gap:26px">
          <div class="stat">
            <span class="stat-n">{@total}</span><span class="small">{ngettext(
              "article",
              "articles",
              @total
            )}</span>
          </div>
        </div>
      </div>

      <div class="card aside-card">
        <span class="micro">{gettext("Most read this month")}</span>
        <a :for={{post, i} <- Enum.with_index(@most_read)} class="arow" href={~p"/#{post.slug}"}>
          <span class="arank">{String.pad_leading("#{i + 1}", 2, "0")}</span>
          <span>
            <span
              lang={post.language}
              style="color:var(--ink);font-weight:600;font-size:14px;display:block"
            >{post.title}</span>
            <span class="small">{gettext("%{minutes} min read", minutes: post.reading_minutes)}</span>
          </span>
        </a>
      </div>

      <div class="card aside-card">
        <span class="micro">{gettext("Topics")}</span>
        <div style="display:flex;gap:7px;flex-wrap:wrap">
          <a :for={topic <- @topics} class="tag" href={~p"/tag/#{topic.slug}"}>{topic.name}</a>
        </div>
      </div>

      <div class="card aside-card">
        <span class="micro">{gettext("About this blog")}</span>
        <p class="small">
          {gettext(
            "One essay a week, written by one person. No link roundups, no sponsorship, no tracking beyond counting reads."
          )}
        </p>
        <div style="display:flex;gap:14px" class="small">
          <a href={~p"/sitemap.xml"}>{gettext("Archive")}</a>
          <a :if={@author} href={~p"/autor/#{@author.slug}"}>{gettext("Contact")}</a>
        </div>
      </div>
    </aside>
  </div>
</div>

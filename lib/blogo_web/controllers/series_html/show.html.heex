<div class="shell pad serie-page">
  <header class="stack serie-head">
    <span class="kicker">Série · {parts_label(length(@series.posts))}</span>
    <h1 class="h1">{@series.name}</h1>
    <p :if={@series.description} class="dek">{@series.description}</p>
  </header>

  <ol class="serie-parts">
    <li :for={{post, i} <- Enum.with_index(@series.posts, 1)} class="serie-part">
      <a href={~p"/#{post.slug}"} class="serie-part-link">
        <span class="serie-n mono">{String.pad_leading("#{i}", 2, "0")}</span>
        <span class="serie-part-text">
          <span class="item-title">{post.title}</span>
          <span :if={post.subtitle} class="item-dek">
            {BlogoWeb.Blocks.inline(post.subtitle)}
          </span>
          <span class="item-meta">
            <span class="mono">{post.reading_minutes} min</span>
            <span>·</span>
            <span class="mono">{format_date(post.published_at)}</span>
          </span>
        </span>
        <span class="thumb serie-thumb"><.hero post={post} /></span>
      </a>
    </li>
  </ol>
</div>

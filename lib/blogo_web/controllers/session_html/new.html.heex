<main class="pad" style="min-height:100vh;display:grid;place-items:center">
  <div class="card" style="width:100%;max-width:400px;padding:34px 32px">
    <p class="kicker" style="margin-bottom:10px">blogo</p>
    <h1 class="h2" style="margin-bottom:6px">Entrar no editor</h1>
    <p class="small" style="margin-bottom:22px">
      O blog é público; escrever nele não é.
    </p>

    <p
      :if={Phoenix.Flash.get(@flash, :error)}
      class="callout callout--bad"
      style="margin-bottom:16px;font-size:14px"
    >
      {Phoenix.Flash.get(@flash, :error)}
    </p>

    <form action={~p"/entrar"} method="post" style="display:flex;flex-direction:column;gap:14px">
      <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

      <label class="ed-field">
        <span class="micro">Senha</span>
        <input
          class="input"
          type="password"
          name="password"
          autocomplete="current-password"
          required
          autofocus
        />
      </label>

      <button class="btn btn--p" type="submit">Entrar</button>
    </form>
  </div>
</main>

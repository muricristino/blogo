<section class="post-head">
  <p class="eyebrow">{@author.headline}</p>
  <h1 class="post-title">{@author.name}</h1>
  <p :if={@author.bio} class="post-sub">{@author.bio}</p>
  <div class="byline">
    <a :for={url <- @author.same_as} href={url} rel="me noopener">{pretty_host(url)}</a>
  </div>
</section>

<div class="post-list">
  <article :for={post <- @posts} class="post-item">
    <a href={~p"/#{post.slug}"}>
      <h2>{post.title}</h2>
      <p :if={post.subtitle}>{post.subtitle}</p>
    </a>
    <div class="post-meta">
      <span>{format_date(post.published_at)}</span>
      <span :if={post.reading_minutes}>{post.reading_minutes} min</span>
    </div>
  </article>
</div>

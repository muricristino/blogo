<!DOCTYPE html>
<%!-- The language of what is on the page, which is not the language of the
      menu around it. An article page declares the language the article was
      written in: a Portuguese essay read with an English interface is still
      Portuguese, and saying otherwise tells a search engine to index it as
      English. A listing is mostly interface, so it takes the interface's. --%>
<html lang={assigns[:content_language] || assigns[:locale_tag] || "pt-BR"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <%= if assigns[:seo] do %>
      <.head {@seo} />
    <% else %>
      <title>{assigns[:page_title] || assigns[:site_name] || "blog"}</title>
    <% end %>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=IBM+Plex+Mono:wght@400&family=IBM+Plex+Sans:wght@400;600&display=swap"
    />
    <meta :if={assigns[:preview?]} name="robots" content="noindex, nofollow" />
    <link
      :if={!assigns[:admin?]}
      rel="alternate"
      type="application/atom+xml"
      title={assigns[:site_name]}
      href={~p"/feed.xml"}
    />
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- Editor and panel share one stylesheet; the public pages never load it. --%>
    <link
      :if={assigns[:admin?]}
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/css/admin.css"}
    />
    <%!-- A reader never loads LiveView: the public pages have no LiveView on
          them, and the editor's bundle is ten times the size of what they use. --%>
    <script
      :if={!assigns[:admin?]}
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/public.js"}
    >
    </script>
    <script
      :if={assigns[:admin?]}
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/admin.js"}
    >
    </script>
  </head>
  <body>
    <script>
      (function () {
        try {
          var t = localStorage.getItem("blogo-theme")
          if (t) document.documentElement.setAttribute("data-theme", t)
        } catch (e) {}
      })()
    </script>
    {@inner_content}
  </body>
</html>

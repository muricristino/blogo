# Copie para deploy/.env e preencha. O arquivo é ignorado pelo git.

# Hostname público. No homelab é o domínio que o webo publica no túnel.
PHX_HOST=blogo.exemplo.com.br

# Gere com: mix phx.gen.secret
SECRET_KEY_BASE=

# Senha do postgres do compose. Troque antes de subir.
POSTGRES_PASSWORD=

# Só fora do homelab: onde a porta 4000 escuta. No homelab o cloudflared
# alcança o container pela rede interna e a porta não é publicada.
# BLOGO_BIND=127.0.0.1

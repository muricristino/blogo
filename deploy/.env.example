# blogo — variáveis do servidor.
#
# Sem as duas chaves do Clerk o blogo entra em modo senha e usa ADMIN_PASSWORD.
# Uma chave sem a outra é recusada no boot: um login meio configurado que cai
# para a senha calado é uma porta que todo mundo acha que está trancada.

# Crie o app em https://dashboard.clerk.com e ligue o Google em
# User & Authentication → Social connections. Development serve: as chaves
# pk_test_/sk_test_ funcionam em qualquer domínio.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Opcional, e tem a última palavra sobre o Clerk: só estes emails entram.
# Um endereço removido daqui para de funcionar na requisição seguinte.
# BLOGO_ALLOWED_EMAILS=voce@exemplo.com

# Só usada quando não há Clerk configurado.
# ADMIN_PASSWORD=
